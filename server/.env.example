# ===========================================
# Safedify AI Server — Environment Variables
# ===========================================
# Copy this file to .env and fill in your values

# Server
NODE_ENV=production
PORT=4000

# JWT Secret — CHANGE THIS in production!
JWT_SECRET=change-me-to-a-long-random-string

# Gemini AI API Key (required for AI agent)
# Get your key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# CORS: comma-separated allowed origins (not needed if frontend served from same server)
# ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Database directory (default: server directory)
# DATA_DIR=/var/data/safedify
