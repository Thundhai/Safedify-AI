# ===========================================
# Safedify AI Server — Environment Variables
# ===========================================
# Copy this file to .env and fill in your values

# Server
NODE_ENV=production
PORT=4000

# JWT Secret — CHANGE THIS in production!
JWT_SECRET=change-me-to-a-long-random-string

# Gemini AI API Key (required for AI agent)
# Get your key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# CORS: comma-separated allowed origins (not needed if frontend served from same server)
# ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Database directory (default: server directory)
# DATA_DIR=/var/data/safedify

# OpenWeatherMap API Key (free tier)
# Sign up at: https://openweathermap.org/appid
# Provides real-time weather, AQI, and air pollution data
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Default site coordinates (for weather/AQI lookup)
# These default to Dubai, UAE — change to your actual site location
SITE_LATITUDE=25.2048
SITE_LONGITUDE=55.2708

# SMTP email settings (for password reset emails)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password
# SMTP_FROM=noreply@safedify.com

# Application URL (used in password reset emails)

# PostgreSQL Database
PG_HOST=postgres
PG_PORT=5432
PG_USER=safedify_user
PG_PASSWORD=safedify_pass
PG_DATABASE=safedify

# Frontend API port (for Vite proxy)
VITE_API_PORT=4000

# Test environment
TEST_DB_URL=postgres://safedify_user:safedify_pass@postgres:5432/safedify
# APP_URL=https://yourdomain.com

# Host binding (default: 0.0.0.0)
# HOST=0.0.0.0

# Seed demo users on first run (set to true for development)
# SEED_DEMO_USERS=true
