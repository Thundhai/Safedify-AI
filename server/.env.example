# ===========================================
# Safedify AI Server — Environment Variables
# ===========================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# This file is for running the server directly (npm run dev:server).
# For Docker Compose, use the root .env.example instead.
# ===========================================

# ---------- SERVER ----------

NODE_ENV=development
PORT=4000

# ---------- AUTHENTICATION ----------

# JWT Secret — CHANGE THIS in production!
# Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string

# JWT token expiration (default: 24h)
# For shorter sessions, use values like '4h', '1d', etc.
JWT_EXPIRES=24h

# bcrypt hashing rounds (default: 12, higher = slower but more secure)
BCRYPT_ROUNDS=12

# ---------- SECURITY (Account Lockout) ----------

# Maximum failed login attempts before account lockout (default: 5)
MAX_LOGIN_ATTEMPTS=5

# Account lockout duration in minutes (default: 15)
LOCKOUT_DURATION_MINUTES=15

# ---------- ABUSE PROTECTION ----------

# Login rate limiting (max failed attempts per IP before temporary block)
# Default: 5 attempts per 15 minutes, 30-minute block with exponential backoff
# LOGIN_RATE_LIMIT_MAX=5
# LOGIN_RATE_LIMIT_WINDOW_MINS=15
# LOGIN_BLOCK_DURATION_MINS=30

# Registration rate limiting (max registrations per IP)
# Default: 3 registrations per hour per IP
# REGISTRATION_RATE_LIMIT_MAX=3
# REGISTRATION_RATE_LIMIT_WINDOW_HOURS=1

# AI generation rate limiting
# Authenticated users: 10 requests/minute (30 for Premium/Enterprise)
# Anonymous users: 3 requests/minute per IP
# AI_RATE_LIMIT_AUTHENTICATED=10
# AI_RATE_LIMIT_ANONYMOUS=3

# Bot detection (production only)
# Block suspected bots with confidence >= 70%
# BOT_DETECTION_THRESHOLD=70

# ---------- EMAIL VERIFICATION ----------

# Set to 'true' to require email verification before login
# New users will receive a verification email after registration
REQUIRE_EMAIL_VERIFICATION=false

# Application URL (used for email links)
# MUST be set correctly in production for email verification links to work
APP_URL=http://localhost:4000

# ---------- AI INTEGRATION ----------

# Gemini AI API Key (required for AI agent, classification, PPE detection)
# Get your key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ---------- DATABASE (PostgreSQL) ----------

# For local development without Docker, use localhost
# For Docker Compose, use 'postgres' (service name)
PG_HOST=localhost
PG_PORT=5432
PG_USER=safedify_user
PG_PASSWORD=safedify_pass
PG_DATABASE=safedify

# Connection pool settings
PG_POOL_MAX=20

# SSL Configuration (REQUIRED for production)
# Set to 'false' only if using self-signed certificates (not recommended)
# PG_SSL_REJECT_UNAUTHORIZED=true

# Alternative: Use DATABASE_URL (for Vercel, Neon, Supabase, etc.)
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# ---------- CORS ----------

# CORS: comma-separated allowed origins
# Not needed if frontend served from same server (production)
# ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ---------- WEATHER & ENVIRONMENTAL ----------

# OpenWeatherMap API Key (free tier)
# Sign up at: https://openweathermap.org/appid
# Provides real-time weather, AQI, and air pollution data
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Default site coordinates (for weather/AQI lookup)
# These default to Dubai, UAE — change to your actual site location
SITE_LATITUDE=25.2048
SITE_LONGITUDE=55.2708

# ---------- EMAIL (SMTP) ----------

# SMTP settings for password reset emails
# Leave empty to log emails to console (development mode)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password
# SMTP_FROM=noreply@safedify.com

# Application URL (used in password reset email links)
APP_URL=http://localhost:4000

# ---------- FILE STORAGE ----------

# Database/uploads directory (default: server directory)
# DATA_DIR=/var/data/safedify

# ---------- DEMO DATA ----------

# Seed demo users on first startup
SEED_DEMO_USERS=true

# Test environment
TEST_DB_URL=postgres://safedify_user:safedify_pass@postgres:5432/safedify
# APP_URL=https://yourdomain.com

# Host binding (default: 0.0.0.0)
# HOST=0.0.0.0

# Seed demo users on first run (set to true for development)
# SEED_DEMO_USERS=true
