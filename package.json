{
  "name": "safedify-ai-platform",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "cd server && node --experimental-sqlite --import tsx index.ts",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:server\"",
    "build": "vite build",
    "build:all": "npm run build && cd server && npm install --production",
    "start": "cd server && NODE_ENV=production node --experimental-sqlite --import tsx index.ts",
    "start:win": "cd server && set NODE_ENV=production && node --experimental-sqlite --import tsx index.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "react-dom": "^19.2.1",
    "react": "^19.2.1",
    "lucide-react": "^0.556.0",
    "react-router-dom": "^7.10.1",
    "recharts": "^3.5.1",
    "@google/genai": "^1.32.0",
    "react-markdown": "9.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.10",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}