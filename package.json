{
  "name": "safedify-ai-platform",
  "private": true,
  "version": "1.0.0",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "cd server && node --import tsx index.ts",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:server\"",
    "build": "vite build",
    "build:api": "esbuild server/index.ts --bundle --platform=node --format=esm --outfile=api/_compiled.mjs --external:better-sqlite3 --external:pg-native --external:nodemailer --banner:js=\"import { createRequire } from 'module'; const require = createRequire(import.meta.url);\"",
    "build:all": "npm run build && cd server && npm install --omit=dev",
    "start": "cd server && node --import tsx index.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "docker:build": "npm run build && cd server && npm install --omit=dev && cd .. && docker build -t safedify-ai .",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "test:e2e": "npx playwright test",
    "test:e2e:ui": "npx playwright test --ui",
    "test:e2e:full": "concurrently \"npx tsx server/index.ts\" \"vite preview --port 3000\""
  },
  "dependencies": {
    "@prisma/client": "^7.5.0",
    "dompurify": "^3.3.2",
    "i18next": "^25.8.14",
    "i18next-browser-languagedetector": "^8.2.1",
    "idb": "^8.0.3",
    "jspdf": "^4.2.0",
    "jspdf-autotable": "^5.0.7",
    "lucide-react": "^0.556.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-hot-toast": "^2.6.0",
    "react-i18next": "^16.5.6",
    "react-markdown": "9.0.1",
    "react-router-dom": "^7.10.1",
    "recharts": "^3.5.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@playwright/test": "^1.58.2",
    "@reduxjs/toolkit": "^2.11.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/dompurify": "^3.0.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.18.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^4.0.18",
    "autoprefixer": "^10.4.20",
    "bcryptjs": "^3.0.3",
    "concurrently": "^9.1.2",
    "jsdom": "^28.1.0",
    "jsonwebtoken": "^9.0.3",
    "postcss": "^8.4.41",
    "prisma": "^7.5.0",
    "supertest": "^7.2.2",
    "tailwindcss": "^3.4.10",
    "tsx": "^4.21.0",
    "typescript": "^5.8.3",
    "uuid": "^13.0.0",
    "vite": "^6.2.0",
    "vitest": "^4.0.18"
  },
  "overrides": {
    "magicast": "^0.5.2"
  }
}
