{
  "installCommand": "npm install && cd server && npm install",
  "buildCommand": "vite build && npx esbuild server/index.ts --bundle --platform=node --format=esm --outfile=api/_compiled.mjs --external:better-sqlite3",
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "memory": 1024,
      "includeFiles": "node_modules/better-sqlite3/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}