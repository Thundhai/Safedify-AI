# ===========================================
# Safedify AI — Environment Variables
# ===========================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# For Docker Compose deployment, these are passed to all services.
# For development, also create server/.env from server/.env.example
# ===========================================

# ---------- REQUIRED ----------

# JWT Secret — REQUIRED in production (64+ chars)
# Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string

# JWT token expiration (default: 24h)
# For shorter sessions: '4h', '1d', etc.
JWT_EXPIRES=24h

# Google Gemini API Key (required for AI features)
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key

# ---------- SECURITY ----------

# bcrypt hashing rounds (default: 12, higher = slower but more secure)
BCRYPT_ROUNDS=12

# Maximum failed login attempts before account lockout (default: 5)
MAX_LOGIN_ATTEMPTS=5

# Account lockout duration in minutes (default: 15)
LOCKOUT_DURATION_MINUTES=15

# Require email verification for new users (default: false)
# Set to 'true' in production with SMTP configured
REQUIRE_EMAIL_VERIFICATION=false

# ---------- DATABASE (PostgreSQL) ----------

# PostgreSQL connection settings
# For Docker Compose: use service name 'postgres' as host
# For local dev: use 'localhost'
PG_HOST=postgres
PG_PORT=5432
PG_USER=safedify_user
PG_PASSWORD=safedify_pass
PG_DATABASE=safedify

# Connection pool settings (max concurrent connections)
PG_POOL_MAX=20

# SSL Configuration (REQUIRED for production)
# Cloud providers (Neon, Supabase, AWS RDS) require SSL
# Set to 'false' only if using self-signed certificates
# PG_SSL_REJECT_UNAUTHORIZED=true

# Alternative: Use DATABASE_URL (for Vercel, Neon, Supabase, etc.)
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# ---------- DATABASE SECURITY NOTES ----------
# 1. NEVER expose PostgreSQL port 5432 to public internet
# 2. Create a dedicated app user with limited permissions (not superuser)
# 3. Always use SSL in production (sslmode=require in connection string)
# 4. Store credentials in environment variables, never in code

# ---------- OPTIONAL INTEGRATIONS ----------

# OpenWeatherMap API Key (for weather/AQI data on environmental page)
# Sign up at: https://openweathermap.org/appid
OPENWEATHER_API_KEY=

# Site coordinates for weather lookup (default: Dubai, UAE)
SITE_LATITUDE=25.2048
SITE_LONGITUDE=55.2708

# ---------- EMAIL (Password Reset) ----------

# SMTP settings for sending password reset emails
# Leave empty to log emails to console (development mode)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@safedify.com

# Public URL (used in password reset email links)
APP_URL=http://localhost:4000

# ---------- FRONTEND ----------

# Vite frontend API URL (for development proxy)
VITE_API_URL=/api
VITE_API_PORT=4000

# ---------- SERVER ----------

# Server port
PORT=4000
NODE_ENV=development

# CORS allowed origins (comma-separated, only if frontend on different domain)
# Example: https://app.safedify.com,https://staging.safedify.com
ALLOWED_ORIGINS=

# Seed demo users on first startup (admin@safedify.com, etc.)
SEED_DEMO_USERS=true