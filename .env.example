# ===========================================
# Safedify AI — Docker Compose Environment
# ===========================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# JWT Secret — REQUIRED in production (64+ chars)
# Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string

# Google Gemini API Key (required for AI features)
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key

# OpenWeatherMap API Key (optional — for weather/AQI data)
# Sign up at: https://openweathermap.org/appid
OPENWEATHER_API_KEY=

# Site coordinates (default: Dubai, UAE)
SITE_LATITUDE=25.2048
SITE_LONGITUDE=55.2708

# SMTP settings (optional — for password reset emails)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@safedify.com

# Public URL (used in password reset email links)
APP_URL=http://localhost:4000

# CORS allowed origins (only if frontend served from different domain)
ALLOWED_ORIGINS=

# Seed demo users on first startup
SEED_DEMO_USERS=true

# External port mapping (default: 4000)
PORT=4000