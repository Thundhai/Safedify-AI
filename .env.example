# ===========================================
# Safedify AI Platform — Environment Variables
# ===========================================
# Copy this file to .env.local and fill in your values

# Gemini AI API Key (required for AI features in the frontend)
# Get your key from: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Backend API URL (leave empty for production — same-origin)
# Only set this for development if NOT using Vite proxy
# VITE_API_URL=http://localhost:4000/api